---
import type { CollectionEntry } from "astro:content";

export interface Props {
  caseStudy: CollectionEntry<"caseStudies">;
}

const { caseStudy } = Astro.props;
const { slug, data } = caseStudy;
const { title, tagline, description, category, featuredImage } = data;
---

<article class="cs-card">
  <a href={`/case-studies/${slug}/`} class="cs-thumb">
    <img
      src={featuredImage ?? "/assets/project-placeholder.svg"}
      alt={title}
      loading="lazy"
    />
    {category && <span class="cs-chip">{category}</span>}
  </a>
  <div class="cs-info">
    <h3>{title}</h3>
    {tagline && <p class="cs-tagline">{tagline}</p>}
    {description && <p class="cs-desc">{description}</p>}
    <a href={`/case-studies/${slug}/`} class="cs-link">View Case Study →</a>
  </div>
</article>

<style>
  .cs-card {
    border: 1px solid rgb(var(--color-border));
    border-radius: 16px;
    overflow: hidden;
    background: rgb(var(--color-fill));
    transition: 0.25s;
    display: flex;
    flex-direction: column;
  }
  .cs-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.08);
  }
  .cs-thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: rgb(var(--color-card));
  }
  .cs-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(1) contrast(1.05);
    transition: transform 0.4s ease;
  }
  .cs-card:hover .cs-thumb img {
    transform: scale(1.04);
  }
  .cs-chip {
    position: absolute;
    left: 14px;
    bottom: 14px;
    background: #171717;
    color: #fff;
    border-radius: 20px;
    padding: 7px 11px;
    font-size: 10px;
  }
  .cs-info {
    padding: 18px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .cs-info h3 {
    font-family: "Playfair Display", serif;
    font-size: 20px;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .cs-tagline {
    font-size: 12px;
    font-style: italic;
    color: rgb(var(--color-accent));
    margin-bottom: 10px;
  }
  .cs-desc {
    font-size: 12px;
    color: rgb(var(--color-accent));
    line-height: 1.6;
    margin-bottom: 15px;
    flex: 1;
  }
  .cs-link {
    font-size: 11px;
    font-weight: 600;
  }
</style>
