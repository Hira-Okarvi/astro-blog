---
import { getEntry } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@config";

const home = (await getEntry("home", "index"))?.data ?? {
  name: SITE.author,
  role: "",
  intro: SITE.desc,
  profileImage: "/assets/profile.svg",
  email: "",
  location: "",
  aboutTitle: "",
  aboutText: "",
  skills: [],
  stats: [],
  highlights: [],
  services: [],
  projects: [],
  experience: [],
  ctaText: "Let's Work Together",
  ctaSub: "",
  ctaLink: "/posts",
};

const [firstName, ...restName] = home.name.split(" ");
const lastName = restName.join(" ");
const aboutParagraphs = home.aboutText.split(/\n\s*\n/).filter(Boolean);
---

<Layout>
  <Header />
  <main id="main-content">

    <!-- ===== Hero ===== -->
    <section class="hero">
      <div class="hero-shape hero-shape-one"></div>
      <div class="hero-shape hero-shape-two"></div>
      <div class="container hero-grid">
        <div class="hero-copy">
          <p class="eyebrow anim" style="--d:0ms">Hello, I'm</p>
          <h1 class="anim" style="--d:80ms">
            {firstName}{lastName && <em> {lastName}</em>}
          </h1>
          {home.role && <h2 class="anim" style="--d:160ms">{home.role}</h2>}
          {home.intro && (
            <p class="hero-text anim" style="--d:240ms">{home.intro}</p>
          )}
          <div class="hero-actions anim" style="--d:320ms">
            <a class="btn btn-dark" href="#portfolio">View My Work <span>→</span></a>
            <a class="btn btn-light" href="#contact">Get In Touch</a>
          </div>
          {
            home.stats.length > 0 && (
              <div class="stats anim" style="--d:400ms">
                {home.stats.map(s => (
                  <div>
                    <strong>{s.value}</strong>
                    <span>{s.label}</span>
                  </div>
                ))}
              </div>
            )
          }
        </div>

        <div class="hero-visual anim" style="--d:300ms">
          <div class="portrait-frame">
            <img src={home.profileImage} alt={home.name} />
          </div>
          <div class="leaf leaf-a">⌁</div>
          <div class="leaf leaf-b">⌁</div>
          <div class="hero-note">Good Design<br /><i>Builds Trust</i><b></b></div>
        </div>
      </div>
    </section>

    <!-- ===== About ===== -->
    <section class="section about" id="about">
      <div class="container about-grid">
        <div class="about-art">
          <div class="mini-card">Turning Ideas<br />Into Websites</div>
          <div class="about-photo">
            <img src={home.profileImage} alt={`${home.name} portrait`} />
          </div>
        </div>
        <div class="about-copy">
          <p class="eyebrow">About Me</p>
          <h2>
            {
              (() => {
                const words = (home.aboutTitle || "Turning Ideas Into Functional Websites").split(" ");
                const mid = Math.ceil(words.length / 2);
                return (
                  <>
                    {words.slice(0, mid).join(" ")}
                    <br />
                    <span>{words.slice(mid).join(" ")}</span>
                  </>
                );
              })()
            }
          </h2>
          {aboutParagraphs.map(p => <p>{p}</p>)}
          {
            home.highlights.length > 0 && (
              <div class="experience-box">
                <h3>My Experience</h3>
                <ul>
                  {home.highlights.map(h => (
                    <li>
                      <b>{h.value}</b> {h.label}
                    </li>
                  ))}
                </ul>
              </div>
            )
          }
        </div>
      </div>
    </section>

    <!-- ===== Services ===== -->
    {
      home.services.length > 0 && (
        <section class="section services" id="services">
          <div class="container">
            <div class="section-head">
              <div>
                <p class="eyebrow">Services</p>
                <h2>What I Can Do For You</h2>
                <p>
                  I offer practical web solutions to help your business grow
                  online.
                </p>
              </div>
              <a href="#contact" class="text-link">Start a Project →</a>
            </div>
            <div class="service-grid">
              {home.services.map(s => (
                <article class="service-card">
                  <div class="icon">{s.icon}</div>
                  <h3>{s.title}</h3>
                  <p>{s.description}</p>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ===== Portfolio ===== -->
    {
      home.projects.length > 0 && (
        <section class="section portfolio" id="portfolio">
          <div class="container">
            <div class="section-head portfolio-head">
              <div>
                <p class="eyebrow">Featured Work</p>
                <h2>Selected Projects</h2>
                <p>
                  A selection of WordPress, eCommerce, travel and business
                  projects.
                </p>
              </div>
              <div class="filters">
                <a class="filter active" href="#portfolio">All</a>
                {[...new Set(home.projects.map(p => p.category).filter(Boolean))].map(
                  c => (
                    <a class="filter" href="#portfolio">{c}</a>
                  )
                )}
              </div>
            </div>
            <div class="project-grid">
              {home.projects.map((p, i) => (
                <article class="project-card">
                  <div class={`project-thumb thumb-${i % 4}`}>
                    <span>{p.category || "Project"}</span>
                  </div>
                  <div class="project-info">
                    <h3>{p.title}</h3>
                    <p>{p.stack}</p>
                    {home.email && <a href={`mailto:${home.email}`}>View Project →</a>}
                  </div>
                </article>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ===== Experience ===== -->
    {
      home.experience.length > 0 && (
        <section class="section experience" id="experience">
          <div class="container experience-grid">
            <div>
              <p class="eyebrow">Experience</p>
              <h2>
                Real Projects.<br />
                <span>Practical Experience.</span>
              </h2>
            </div>
            <div class="timeline">
              {home.experience.map(e => (
                <div class="timeline-item">
                  <span class="timeline-dot"></span>
                  <p class="time">{e.time}</p>
                  <h3>{e.title}</h3>
                  <p>{e.description}</p>
                </div>
              ))}
            </div>
          </div>
        </section>
      )
    }

    <!-- ===== CTA ===== -->
    <section class="section cta" id="contact">
      <div class="container cta-box">
        <div>
          <p class="eyebrow eyebrow-light">Let's Work Together</p>
          <h2>{home.ctaText}</h2>
          {home.ctaSub && <p>{home.ctaSub}</p>}
        </div>
        <a class="btn btn-white" href={home.ctaLink}>Start a Project →</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Layout helpers ===== */
  section {
    max-width: 100%;
    margin: 0;
    padding: 0;
  }
  .container {
    width: min(1180px, calc(100% - 48px));
    margin: auto;
  }
  .section {
    padding: 100px 0;
  }
  .eyebrow {
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: 700;
    color: rgb(var(--color-accent));
    margin-bottom: 12px;
    text-transform: uppercase;
  }
  .eyebrow-light {
    color: #999;
  }

  /* ===== Entrance animation ===== */
  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .anim {
    opacity: 0;
    animation: fade-up 0.8s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    animation-delay: var(--d, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    .anim {
      animation: none;
      opacity: 1;
    }
  }

  /* ===== Hero ===== */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(
      120deg,
      rgb(var(--color-fill)) 0%,
      rgb(var(--color-card)) 100%
    );
    min-height: 650px;
    display: flex;
    align-items: center;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr 0.9fr;
    align-items: center;
    gap: 30px;
    position: relative;
    z-index: 2;
  }
  .hero-copy {
    padding: 75px 0 60px;
  }
  .hero h1 {
    font-size: clamp(52px, 6vw, 82px);
    line-height: 1.03;
    letter-spacing: -3px;
    font-weight: 700;
  }
  .hero h1 em {
    font-family: "Playfair Display", serif;
    font-weight: 500;
  }
  .hero h2 {
    font-size: 24px;
    margin-top: 12px;
    letter-spacing: -0.5px;
  }
  .hero-text {
    max-width: 560px;
    color: rgb(var(--color-accent));
    font-size: 16px;
    margin-top: 18px;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    margin-top: 30px;
    flex-wrap: wrap;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: 10px;
    font-size: 13px;
    font-weight: 600;
    padding: 14px 21px;
    border: 1px solid rgb(var(--color-text-base));
    transition: 0.25s;
  }
  .btn-dark {
    background: rgb(var(--color-text-base));
    color: rgb(var(--color-fill));
  }
  .btn-dark:hover {
    transform: translateY(-2px);
    opacity: 0.85;
  }
  .btn-light {
    background: rgb(var(--color-fill));
    color: rgb(var(--color-text-base));
  }
  .btn-light:hover {
    background: rgb(var(--color-card));
  }
  .stats {
    display: flex;
    gap: 0;
    margin-top: 52px;
  }
  .stats div {
    padding: 0 28px;
    border-right: 1px solid rgb(var(--color-border));
    display: flex;
    flex-direction: column;
  }
  .stats div:first-child {
    padding-left: 0;
  }
  .stats div:last-child {
    border: 0;
  }
  .stats strong {
    font-size: 17px;
  }
  .stats span {
    font-size: 11px;
    color: rgb(var(--color-accent));
    margin-top: 3px;
  }

  /* ===== Hero visual ===== */
  .hero-visual {
    height: 600px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    position: relative;
  }
  .portrait-frame {
    width: min(450px, 80%);
    height: 520px;
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    background: radial-gradient(
      circle at 50% 38%,
      rgb(var(--color-card)) 0,
      rgb(var(--color-card)) 42%,
      transparent 43%
    );
    overflow: hidden;
  }
  .portrait-frame::before {
    content: "";
    position: absolute;
    width: 390px;
    height: 470px;
    background: rgb(var(--color-card));
    border: 1px solid rgb(var(--color-border));
    border-radius: 48% 52% 12% 12%;
    bottom: 0;
    transform: rotate(3deg);
  }
  .portrait-frame img {
    position: relative;
    z-index: 2;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: grayscale(1) contrast(1.05);
  }
  .hero-note {
    position: absolute;
    right: 0;
    top: 170px;
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-size: 17px;
    transform: rotate(-5deg);
  }
  .hero-note b {
    display: block;
    width: 80px;
    height: 2px;
    background: rgb(var(--color-text-base));
    margin: 8px 0 0 auto;
  }
  .leaf {
    position: absolute;
    font-size: 80px;
    color: rgb(var(--color-accent));
    opacity: 0.3;
    transform: rotate(35deg);
    animation: float 7s ease-in-out infinite;
  }
  .leaf-a {
    left: 8%;
    bottom: 30%;
  }
  .leaf-b {
    right: 5%;
    bottom: 20%;
    transform: rotate(-25deg);
    animation-delay: 1.6s;
  }
  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -14px;
    }
  }
  .hero-shape-one {
    position: absolute;
    width: 250px;
    height: 250px;
    background: rgb(var(--color-text-base));
    top: -140px;
    left: -100px;
    border-radius: 50%;
    opacity: 0.9;
  }
  .hero-shape-two {
    position: absolute;
    width: 170px;
    height: 170px;
    border: 1px solid rgb(var(--color-border));
    border-radius: 50%;
    right: -70px;
    top: 80px;
  }

  /* ===== About ===== */
  .about-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: 80px;
    align-items: center;
  }
  .about-art {
    height: 440px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .about-photo {
    width: 350px;
    height: 400px;
    background: rgb(var(--color-card));
    border-radius: 36px 36px 100px 100px;
    overflow: hidden;
    position: relative;
  }
  .about-photo img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    filter: grayscale(1) contrast(1.05);
  }
  .mini-card {
    position: absolute;
    left: 0;
    top: 25px;
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-size: 17px;
    z-index: 3;
    transform: rotate(-7deg);
  }
  .about-copy h2,
  .section-head h2,
  .experience h2,
  .cta h2 {
    font-size: 42px;
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: 22px;
    font-weight: 700;
  }
  .about-copy h2 span,
  .experience h2 span {
    font-family: "Playfair Display", serif;
    font-style: italic;
    font-weight: 500;
  }
  .about-copy > p {
    color: rgb(var(--color-accent));
    max-width: 670px;
    margin-bottom: 15px;
  }
  .experience-box {
    margin-top: 25px;
    background: rgb(var(--color-card));
    border: 1px solid rgb(var(--color-border));
    padding: 24px 27px;
    border-radius: 16px;
  }
  .experience-box h3 {
    font-size: 17px;
    margin-bottom: 12px;
  }
  .experience-box ul {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 9px;
    list-style: none;
    font-size: 12px;
    color: rgb(var(--color-accent));
  }
  .experience-box li::before {
    content: "✓";
    color: rgb(var(--color-text-base));
    font-weight: 700;
    margin-right: 8px;
  }
  .experience-box b {
    color: rgb(var(--color-text-base));
  }

  /* ===== Services ===== */
  .services {
    background: rgb(var(--color-card));
  }
  .section-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 30px;
    margin-bottom: 38px;
  }
  .section-head h2 {
    font-size: 38px;
    margin-bottom: 6px;
  }
  .section-head p:not(.eyebrow) {
    color: rgb(var(--color-accent));
    font-size: 14px;
  }
  .text-link {
    font-size: 13px;
    font-weight: 600;
    border-bottom: 1px solid rgb(var(--color-text-base));
    padding-bottom: 4px;
    white-space: nowrap;
  }
  .service-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 14px;
  }
  .service-card {
    background: rgb(var(--color-fill));
    border: 1px solid rgb(var(--color-border));
    border-radius: 14px;
    padding: 24px 17px;
    min-height: 240px;
    transition: 0.25s;
  }
  .service-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.07);
  }
  .service-card .icon {
    font-size: 22px;
    margin-bottom: 25px;
  }
  .service-card h3 {
    font-size: 15px;
    line-height: 1.25;
    margin-bottom: 12px;
  }
  .service-card p {
    font-size: 12px;
    color: rgb(var(--color-accent));
    line-height: 1.6;
  }

  /* ===== Portfolio ===== */
  .portfolio-head {
    align-items: center;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    justify-content: flex-end;
  }
  .filter {
    border: 1px solid rgb(var(--color-border));
    background: rgb(var(--color-fill));
    border-radius: 20px;
    padding: 8px 13px;
    font-size: 11px;
    color: rgb(var(--color-accent));
  }
  .filter.active {
    background: rgb(var(--color-text-base));
    color: rgb(var(--color-fill));
    border-color: rgb(var(--color-text-base));
  }
  .project-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 22px;
  }
  .project-card {
    border: 1px solid rgb(var(--color-border));
    border-radius: 16px;
    overflow: hidden;
    background: rgb(var(--color-fill));
    transition: 0.25s;
  }
  .project-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 14px 35px rgba(0, 0, 0, 0.08);
  }
  .project-thumb {
    height: 205px;
    padding: 20px;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
    position: relative;
    overflow: hidden;
  }
  .project-thumb::after {
    content: "";
    position: absolute;
    width: 190px;
    height: 120px;
    background: rgba(255, 255, 255, 0.72);
    border: 5px solid #222;
    border-radius: 8px;
    top: 28px;
    left: 50%;
    transform: translateX(-50%) rotate(-2deg);
    box-shadow: 0 15px 25px rgba(0, 0, 0, 0.12);
    transition: transform 0.3s ease;
  }
  .project-card:hover .project-thumb::after {
    transform: translateX(-50%) rotate(0deg) scale(1.03);
  }
  html[data-theme="dark"] .project-thumb::after {
    background: rgba(20, 20, 20, 0.72);
    border-color: #ddd;
  }
  .project-thumb span {
    position: relative;
    z-index: 2;
    background: #171717;
    color: #fff;
    border-radius: 20px;
    padding: 7px 11px;
    font-size: 10px;
  }
  .thumb-0 {
    background: linear-gradient(135deg, #e3e3e1, #f5f5f3);
  }
  .thumb-1 {
    background: linear-gradient(135deg, #d8d8d8, #f0f0ee);
  }
  .thumb-2 {
    background: linear-gradient(135deg, #ececea, #d9d9d9);
  }
  .thumb-3 {
    background: linear-gradient(135deg, #d5d5d5, #eeeeec);
  }
  .project-info {
    padding: 18px;
  }
  .project-info h3 {
    font-size: 16px;
    margin-bottom: 5px;
  }
  .project-info p {
    font-size: 11px;
    color: rgb(var(--color-accent));
    margin-bottom: 15px;
  }
  .project-info a {
    font-size: 11px;
    font-weight: 600;
  }

  /* ===== Experience ===== */
  .experience {
    background: rgb(var(--color-card));
  }
  .experience-grid {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 100px;
  }
  .timeline {
    border-left: 1px solid rgb(var(--color-border));
    padding-left: 34px;
  }
  .timeline-item {
    position: relative;
    padding-bottom: 38px;
  }
  .timeline-item:last-child {
    padding-bottom: 0;
  }
  .timeline-dot {
    position: absolute;
    left: -41px;
    top: 4px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: rgb(var(--color-text-base));
    border: 3px solid rgb(var(--color-card));
    box-shadow: 0 0 0 1px rgb(var(--color-text-base));
  }
  .time {
    font-size: 10px;
    letter-spacing: 2px;
    font-weight: 700;
    color: rgb(var(--color-accent));
    margin-bottom: 8px;
  }
  .timeline h3 {
    font-size: 20px;
    margin-bottom: 8px;
  }
  .timeline-item > p:last-child {
    color: rgb(var(--color-accent));
    font-size: 14px;
    max-width: 620px;
  }

  /* ===== CTA ===== */
  .cta-box {
    background: #171717;
    color: #fff;
    border-radius: 24px;
    padding: 58px 65px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
    overflow: hidden;
    position: relative;
  }
  .cta-box::after {
    content: "";
    position: absolute;
    width: 250px;
    height: 250px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 50%;
    right: -80px;
    top: -120px;
  }
  .cta h2 {
    margin-bottom: 8px;
    color: #fff;
  }
  .cta p:not(.eyebrow) {
    color: #bdbdbd;
  }
  .btn-white {
    background: #fff;
    color: #171717;
    border-color: #fff;
    position: relative;
    z-index: 2;
    white-space: nowrap;
  }
  .btn-white:hover {
    background: #eee;
  }

  /* ===== Responsive ===== */
  @media (max-width: 1050px) {
    .service-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .hero-grid {
      grid-template-columns: 1fr 0.8fr;
    }
    .hero h1 {
      font-size: 62px;
    }
    .about-grid {
      gap: 45px;
    }
  }
  @media (max-width: 800px) {
    .container {
      width: min(100% - 30px, 650px);
    }
    .hero {
      min-height: auto;
    }
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-copy {
      padding: 65px 0 20px;
    }
    .hero-visual {
      height: 480px;
    }
    .hero-note {
      right: 5%;
      top: 80px;
    }
    .stats {
      margin-top: 38px;
    }
    .about-grid,
    .experience-grid {
      grid-template-columns: 1fr;
      gap: 45px;
    }
